import { Button, LineEdit, ComboBox, CheckBox, Switch, SpinBox, ScrollView, ListView, ProgressIndicator, Palette } from "std-widgets.slint";

// ───────────── 调色板 (dataviz 校验值, 暗色表面) ─────────────
global Pal {
    out property <color> plane:   #0d0d0d;
    out property <color> surface: #1a1a19;
    out property <color> card:    #232322;
    out property <color> card2:   #2a2a28;
    out property <color> ink:     #ffffff;
    out property <color> ink2:    #c3c2b7;
    out property <color> muted:   #898781;
    out property <color> grid:    #2c2c2a;
    out property <color> accent:  #3987e5;   // 单序列蓝 (dark series-1)
    out property <color> good:    #0ca30c;
    out property <color> warn:    #fab219;
    out property <color> crit:    #d03b3b;
}

export struct HostRow  { ip: string, mac: string, is-self: bool }
export struct TierRow  { label: string, loss: string, avg: string, jit: string, err: string, verdict: string, color: color, link: string }
export struct ChartPoint { x: float, y: float, value: string, label: string }

// 结果卡里的判定徽章
component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 24px;
    border-radius: 12px;
    background: tint.transparentize(0.82);
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component Card inherits Rectangle {
    background: Pal.card;
    border-radius: 16px;
    border-width: 1px;
    border-color: #ffffff.transparentize(0.9);
}

export component AppWindow inherits Window {
    title: "网卡自适应测速";
    preferred-width: 980px;
    preferred-height: 700px;
    min-width: 900px;
    min-height: 640px;
    background: Pal.plane;
    default-font-size: 14px;

    // ── 状态 (Rust 填充) ──
    in property <[string]> nic-names;
    in property <string> nic-detail: "—";
    in-out property <int> selected-nic: 0;
    in-out property <string> target: "";
    in-out property <bool> do-mtu: true;
    in-out property <bool> do-stats: true;
    in-out property <int> ping-count: 10;

    in property <bool> busy: false;
    in property <string> status: "就绪";
    in property <string> precheck-text: "—";
    in property <color> precheck-color: Pal.muted;
    in property <string> mtu-text: "—";
    in property <[TierRow]> tiers;

    in property <bool> show-hosts: false;
    in property <bool> scanning: false;
    in property <float> scan-progress: 0;
    in property <[HostRow]> hosts;

    in property <string> chart-path;
    in property <[ChartPoint]> chart-points;
    in property <string> chart-ymax: "";
    in property <string> chart-ymin: "";
    in property <bool> has-chart: false;

    // ── 事件 (Rust 处理) ──
    callback refresh-nics();
    callback nic-changed(int);
    callback open-scan();
    callback close-scan();
    callback pick-host(int);
    callback start-test();

    init => { Palette.color-scheme = ColorScheme.dark; }

    VerticalLayout {
        // ───────── 顶栏 ─────────
        Rectangle {
            height: 64px;
            background: Pal.surface;
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px;
                spacing: 12px;
                Rectangle {
                    width: 32px; height: 32px; y: (parent.height - self.height)/2;
                    border-radius: 9px;
                    background: Pal.accent.transparentize(0.8);
                    Text { text: "◈"; color: Pal.accent; font-size: 18px; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "网卡自适应测速"; color: Pal.ink; font-size: 18px; font-weight: 800; }
                    Text { text: "链路协商 100M / 10M / 1000M · 丢包 · 延迟 · MTU"; color: Pal.muted; font-size: 11px; }
                }
                Rectangle {} // 撑开
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px; y: (parent.height - self.height)/2;
                            background: root.busy ? Pal.warn : Pal.good;
                        }
                        Text { text: root.status; color: Pal.ink2; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }
        }
        if root.busy : Rectangle {
            height: 3px;
            ProgressIndicator { width: 100%; height: 100%; indeterminate: true; }
        }

        // ───────── 主体 ─────────
        HorizontalLayout {
            padding: 20px; spacing: 20px;

            // ── 左侧: 控制面板 ──
            Card {
                width: 320px;
                VerticalLayout {
                    padding: 20px; spacing: 14px;

                    Text { text: "配置"; color: Pal.ink; font-size: 15px; font-weight: 700; }

                    Text { text: "网卡"; color: Pal.ink2; font-size: 12px; }
                    ComboBox {
                        model: root.nic-names;
                        current-index <=> root.selected-nic;
                        enabled: !root.busy;
                        selected(v) => { root.nic-changed(self.current-index); }
                    }
                    Text {
                        text: root.nic-detail;
                        color: Pal.muted; font-size: 11px; wrap: word-wrap;
                    }
                    Button {
                        text: "⟳  刷新网卡";
                        enabled: !root.busy;
                        clicked => { root.refresh-nics(); }
                    }

                    Rectangle { height: 1px; background: Pal.grid; }

                    Text { text: "目标 IP"; color: Pal.ink2; font-size: 12px; }
                    LineEdit {
                        placeholder-text: "例如 192.168.1.1";
                        text <=> root.target;
                        enabled: !root.busy;
                    }
                    Button {
                        text: "◎  扫描局域网";
                        enabled: !root.busy;
                        clicked => { root.open-scan(); }
                    }

                    Rectangle { height: 1px; background: Pal.grid; }

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "MTU 大包探测"; color: Pal.ink2; font-size: 13px; vertical-alignment: center; }
                        Switch { checked <=> root.do-mtu; enabled: !root.busy; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "网卡错误计数器"; color: Pal.ink2; font-size: 13px; vertical-alignment: center; }
                        Switch { checked <=> root.do-stats; enabled: !root.busy; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "每档发包数"; color: Pal.ink2; font-size: 13px; vertical-alignment: center; }
                        SpinBox {
                            width: 110px;
                            minimum: 3; maximum: 100;
                            value <=> root.ping-count;
                            enabled: !root.busy;
                        }
                    }

                    Rectangle {} // 撑开

                    Button {
                        text: root.busy ? "测试进行中…" : "▶  开始测试";
                        primary: true;
                        enabled: !root.busy && root.nic-names.length > 0;
                        height: 44px;
                        clicked => { root.start-test(); }
                    }
                }
            }

            // ── 右侧: 结果 ──
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px; spacing: 16px;

                    // 预检 & MTU 概览
                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            background: Pal.card2; border-radius: 12px; horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px; spacing: 4px;
                                Text { text: "连通性预检"; color: Pal.muted; font-size: 11px; }
                                Text { text: root.precheck-text; color: root.precheck-color; font-size: 15px; font-weight: 700; }
                            }
                        }
                        Rectangle {
                            background: Pal.card2; border-radius: 12px; horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px; spacing: 4px;
                                Text { text: "路径 MTU"; color: Pal.muted; font-size: 11px; }
                                Text { text: root.mtu-text; color: Pal.ink; font-size: 15px; font-weight: 700; }
                            }
                        }
                    }

                    // 档位表
                    Text { text: "逐档结果"; color: Pal.ink; font-size: 15px; font-weight: 700; }
                    Rectangle {
                        background: Pal.card2; border-radius: 12px;
                        VerticalLayout {
                            padding: 6px;
                            // 表头
                            HorizontalLayout {
                                padding: 10px; spacing: 6px;
                                Text { text: "档位"; width: 62px; color: Pal.muted; font-size: 11px; }
                                Text { text: "丢包"; width: 60px; color: Pal.muted; font-size: 11px; }
                                Text { text: "平均ms"; width: 72px; color: Pal.muted; font-size: 11px; }
                                Text { text: "抖动ms"; width: 66px; color: Pal.muted; font-size: 11px; }
                                Text { text: "错误"; width: 48px; color: Pal.muted; font-size: 11px; }
                                Text { text: "判定"; color: Pal.muted; font-size: 11px; }
                            }
                            for row in root.tiers : Rectangle {
                                height: 46px;
                                background: touch.has-hover ? Pal.card : transparent;
                                border-radius: 8px;
                                touch := TouchArea {}
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 6px;
                                    VerticalLayout {
                                        width: 62px; alignment: center;
                                        Text { text: row.label; color: Pal.ink; font-size: 14px; font-weight: 700; }
                                        Text { text: row.link; color: Pal.muted; font-size: 10px; }
                                    }
                                    Text { text: row.loss; width: 60px; color: Pal.ink2; font-size: 13px; vertical-alignment: center; }
                                    Text { text: row.avg; width: 72px; color: Pal.ink2; font-size: 13px; vertical-alignment: center; }
                                    Text { text: row.jit; width: 66px; color: Pal.ink2; font-size: 13px; vertical-alignment: center; }
                                    Text { text: row.err; width: 48px; color: row.err == "0" ? Pal.ink2 : Pal.crit; font-size: 13px; vertical-alignment: center; }
                                    HorizontalLayout {
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Chip { text: row.verdict; tint: row.color; }
                                        }
                                    }
                                }
                            }
                            if root.tiers.length == 0 : Rectangle {
                                height: 80px;
                                Text {
                                    text: "尚无数据 · 选好网卡与目标后点“开始测试”";
                                    color: Pal.muted; font-size: 12px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 延迟折线图
                    Text { text: "各档平均延迟 (ms)"; color: Pal.ink; font-size: 15px; font-weight: 700; }
                    Rectangle {
                        background: Pal.surface; border-radius: 12px;
                        vertical-stretch: 1; min-height: 180px;
                        HorizontalLayout {
                            padding: 14px; spacing: 8px;
                            // y 轴刻度
                            VerticalLayout {
                                width: 44px;
                                Text { text: root.chart-ymax; color: Pal.muted; font-size: 10px; horizontal-alignment: right; }
                                Rectangle {}
                                Text { text: root.chart-ymin; color: Pal.muted; font-size: 10px; horizontal-alignment: right; }
                            }
                            // 绘图区
                            plot := Rectangle {
                                horizontal-stretch: 1;
                                // 基线
                                Rectangle { y: parent.height - 1px; height: 1px; background: Pal.grid; }
                                if root.has-chart : Path {
                                    width: 100%; height: 100%;
                                    viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 100;
                                    commands: root.chart-path;
                                    stroke: Pal.accent;
                                    stroke-width: 2px;
                                }
                                for pt in root.chart-points : Rectangle {
                                    width: 10px; height: 10px; border-radius: 5px;
                                    background: Pal.accent;
                                    border-width: 2px; border-color: Pal.surface;
                                    x: parent.width * pt.x - self.width/2;
                                    y: parent.height * pt.y - self.height/2;
                                }
                                for pt in root.chart-points : Text {
                                    text: pt.value;
                                    color: Pal.ink; font-size: 10px; font-weight: 700;
                                    x: parent.width * pt.x - self.width/2;
                                    y: parent.height * pt.y - 22px;
                                    horizontal-alignment: center;
                                }
                                if !root.has-chart : Text {
                                    text: "测试完成后显示折线图";
                                    color: Pal.muted; font-size: 12px;
                                    x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                                }
                            }
                        }
                    }
                    // x 轴档位标签
                    HorizontalLayout {
                        padding-left: 52px;
                        for pt in root.chart-points : Text {
                            text: pt.label;
                            color: Pal.muted; font-size: 11px;
                            horizontal-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // ───────── 局域网扫描浮层 ─────────
    if root.show-hosts : Rectangle {
        background: #000000.transparentize(0.5);
        TouchArea { clicked => { root.close-scan(); } }
        Rectangle {
            width: 460px; height: 460px;
            background: Pal.card; border-radius: 18px;
            border-width: 1px; border-color: #ffffff.transparentize(0.9);
            TouchArea {} // 吃掉点击, 防止穿透关闭
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "局域网主机发现"; color: Pal.ink; font-size: 16px; font-weight: 800; }
                    Rectangle {}
                    Text {
                        text: "✕"; color: Pal.muted; font-size: 16px;
                        TouchArea { clicked => { root.close-scan(); } }
                    }
                }
                if root.scanning : Rectangle {
                    height: 6px; border-radius: 3px; background: Pal.grid;
                    Rectangle {
                        x: 0; height: 100%; border-radius: 3px;
                        width: parent.width * root.scan-progress;
                        background: Pal.accent;
                    }
                }
                Text {
                    text: root.scanning ? "扫描中… " + round(root.scan-progress * 100) + "%"
                                        : "发现 " + root.hosts.length + " 台主机 · 点击选为目标";
                    color: Pal.muted; font-size: 12px;
                }
                ListView {
                    for h[i] in root.hosts : Rectangle {
                        height: 48px;
                        background: ta.has-hover ? Pal.card2 : transparent;
                        border-radius: 8px;
                        ta := TouchArea { clicked => { root.pick-host(i); } }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 10px;
                            Text { text: "▸"; color: Pal.good; font-size: 14px; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: h.ip; color: Pal.ink; font-size: 14px; font-weight: 600; }
                                Text { text: h.mac; color: Pal.muted; font-size: 10px; }
                            }
                            Rectangle {}
                            if h.is-self : VerticalLayout {
                                alignment: center;
                                Chip { text: "本机"; tint: Pal.muted; }
                            }
                        }
                    }
                }
            }
        }
    }
}
